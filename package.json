{
  "name": "Northstar-Quality-Operations",
  "version": "4.3.2",
  "private": true,
  "description": "Quality operations desktop workspace",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "npm run build:icon",
    "dev": "concurrently --kill-others --names vite,electron --success command-electron \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "predesktop": "npm run build:icon",
    "build": "vite build",
    "build:icon": "node scripts/build-icon.cjs",
    "desktop": "electron .",
    "package:win": "npm run build && npm run build:icon && electron-builder --win",
    "prestart": "npm run build:icon",
    "seed:admin": "node scripts/seed-admin.cjs",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.9",
    "file-saver": "^2.0.5",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.17.0",
    "nodemailer": "^10.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-js-style": "^1.2.0"
  },
  "build": {
    "appId": "com.orientgroup.qasys",
    "productName": "Northstar Quality Operations",
    "directories": {
      "buildResources": ".",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "quality-assurance.ico",
      "package.json",
      ".env.example"
    ],
    "win": {
      "icon": "quality-assurance.ico",
      "artifactName": "Northstar-Quality-Operations-Setup-${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "nsis": {
      "artifactName": "Northstar-Quality-Operations-Setup-${version}.${ext}",
      "installerIcon": "quality-assurance.ico",
      "uninstallerIcon": "quality-assurance.ico",
      "installerHeaderIcon": "quality-assurance.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.33.5",
    "vite": "^6.3.5",
    "wait-on": "^8.0.4"
  }
}